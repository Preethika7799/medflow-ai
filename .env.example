# MEDFLOW_ENV=default uses configs/default.yaml; overlays development.yaml / production.yaml when set
MEDFLOW_ENV=default
MEDFLOW_CONFIG_DIR=configs
MEDFLOW_SECRETS_PATH=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Local Qdrant or Cloud (set URL + API key for Cloud)
MEDFLOW_QDRANT__HOST=localhost
MEDFLOW_QDRANT__PORT=6333
MEDFLOW_QDRANT__URL=
MEDFLOW_QDRANT__API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

API_RATE_LIMIT_PER_MINUTE=120
